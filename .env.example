SESSION_SECRET=
FORCE_HTTPS=0
PORT=5001

# Fase 0+ (echte Postgres i.p.v. de sqlite3-devlaag)
DATABASE_URL=postgresql://user:password@localhost:5432/secondscent

# Fase 4 (jouw eigen Stripe-account — zie docs/ARCHITECTURE.md § D)
# PAYMENTS_MODE=fake (default) gebruikt de ingebouwde FakeStripeClient —
# geen echte Stripe-koppeling nodig om alles hier lokaal te draaien/testen.
# Zet op "live" + vul beide sleutels hieronder in zodra je een eigen
# Stripe-account hebt (dat kan alleen jijzelf aanmaken).
PAYMENTS_MODE=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
